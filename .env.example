# ===== IA (obrigatório para gerar conteúdos e escolher cortes) =====
# Chave PRÓPRIA das redes sociais (nome sugerido no Claude Console: "carretos-redes-sociais").
# NÃO usar as chaves "carretos-github" / "carretos-avaliacoes" do sistema de avaliações.
SOCIAL_ANTHROPIC_API_KEY=

# ===== Instagram (Graph API: conta Profissional ligada a Página Facebook) =====
IG_DAVIDCARRETO_TOKEN=
IG_DAVIDCARRETO_USER_ID=
IG_CARRETOCLIPS_TOKEN=
IG_CARRETOCLIPS_USER_ID=
META_GRAPH_VERSION=v21.0

# ===== TikTok (Content Posting API + Display API) =====
TT_DAVIDCARRETO_TOKEN=
TT_CARRETOCLIPS_TOKEN=
# SELF_ONLY até a app ser auditada pelo TikTok; depois PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY=SELF_ONLY

# ===== LinkedIn (Posts API) =====
LI_DAVIDCARRETO_TOKEN=
LI_DAVIDCARRETO_URN=urn:li:person:XXXXXXXX
LI_CARRETOSGROUP_TOKEN=
LI_CARRETOSGROUP_URN=urn:li:organization:XXXXXXXX
LINKEDIN_VERSION=202510

# ===== Alojamento de imagens (o Instagram exige URL público para imagens/capas) =====
# Ficheiros públicos para o Instagram/Facebook: por defeito o próprio servidor (<dashboard>/publico/).
# Só preencher se quiser usar um bucket S3/R2 em vez disso.
MEDIA_HOST=folder
S3_BUCKET=
S3_ENDPOINT_URL=
MEDIA_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== Notificações no telemóvel (opcional, recomendado) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Vídeos criados do zero =====
# Vídeos e fotos de stock gratuitos (uso comercial permitido).
# Pixabay (principal): chave grátis em https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Pexels (opcional; se existir, tem prioridade). A Pexels suspendeu a emissão de novas chaves.
PEXELS_API_KEY=
# Voz da narração (Piper, grátis e local). Outras vozes PT: ver https://huggingface.co/rhasspy/piper-voices
PIPER_VOICE=pt_PT-tugão-medium
# Modelo de legendas (tiny | base | small | medium). "small" é o equilíbrio qualidade/velocidade
WHISPER_MODEL=small

# ===== Serviços PAGOS opcionais (só ativar com aprovação) =====
# Voz clonada profissional (ElevenLabs): narrador "david_elevenlabs" em config/brand.yaml
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Avatar a falar (HeyGen): comando `carretos avatar-video`
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# ===== Dashboard =====
# No servidor, o administrador (utilizador "david") é criado na página /configurar com o SETUP_CODE.
# Opcional (uso local): se definida e ainda não houver utilizadores, cria o "david" com esta palavra-passe.
DASHBOARD_PASSWORD=

# ===== Envio de emails (convites e "esqueci-me da palavra-passe") =====
# Conta de email PRÓPRIA deste sistema. NÃO usar a palavra-passe de aplicação "carretos-avaliacoes".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
